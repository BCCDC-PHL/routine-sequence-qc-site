  },
  "homepage": "https://github.com/BCCDC-PHL/routine-sequence-qc-site#readme",
  "devDependencies": {
    "shadow-cljs": "^3.4.11"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ag-grid-community": "^35.0.1",
    "ag-grid-react": "^35.0.1"
  }
}
